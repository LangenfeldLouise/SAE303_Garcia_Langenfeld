---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Bordeaux Métropole</title>
  </head>
  <body>
    <div
      class="navbar bg-primary text-primary-content shadow-sm fixed top-0 z-50"
    >
      <div class="navbar-start">
        <div class="dropdown">
          <div tabindex="0" role="button" class="btn btn-ghost lg:hidden">
            <svg
              aria-label="Menu"
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="white"
              viewBox="0 0 24 24"
              stroke="white"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h8m-8 6h16"></path>
            </svg>
          </div>
          <ul
            tabindex="-1"
            class="menu menu-sm dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 shadow"
          >
            <li><a href="/">Accueil</a></li>
            <li><a href="/incendies-bordeaux">Incendies Bordeaux</a></li>
            <li><a href="/incendies-france">Incendies France</a></li>
          </ul>
        </div>
        <a class="btn btn-ghost text-xl text-primary-content" href="/"
          >SAE 303</a
        >
      </div>
      <div class="navbar-center hidden lg:flex">
        <ul class="menu menu-horizontal px-1">
          <li><a href="/">Accueil</a></li>
          <li>
            <a href="/incendies-bordeaux">Incendies Bordeaux</a>
          </li>
          <li><a href="/incendies-france">Incendies France</a></li>
        </ul>
      </div>
      <div class="navbar-end">
        <a class="btn">Button</a>
      </div>
    </div>
    <main class="m-10 lg:m-20">
      <slot />
    </main>
    <footer
      class="footer sm:footer-horizontal footer-center bg-primary text-primary-content p-4"
    >
      <aside>
        <p>
          Copyright © {new Date().getFullYear()} - All right reserved :)
        </p>
      </aside>
    </footer>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  :global(.hero) {
    width: calc(100% + 5rem);
    margin: -2.5rem 0 2.5rem -2.5rem;
  }

  @media (min-width: 1024px) {
    :global(.hero) {
      width: calc(100% + 10rem);
      margin: -5rem 0 5rem -5rem;
    }
  }
</style>
